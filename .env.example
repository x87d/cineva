# Get a free key at https://www.themoviedb.org/settings/api  (use the v3 "API Key")
# This stays server-side (proxy / Vercel env var) and is never sent to the browser.
TMDB_API_KEY=your_tmdb_v3_api_key_here

# Supabase (Project Settings -> API Keys). The publishable key is browser-safe (RLS guards data).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here
